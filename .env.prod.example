# Production environment values for the deployment host.
# Keep this file on the server and do not commit it.

SECRET_KEY=replace-with-a-long-random-secret-key
DB_MIGRATE_PASSWORD=replace-with-a-strong-random-password
DB_APP_PASSWORD=replace-with-a-strong-random-password
REDIS_PASSWORD=replace-with-a-strong-random-password

# --- Host / domain ---
DEBUG=False
ALLOWED_HOSTS=uasspain.example.com,www.uasspain.example.com,backend,nginx
FRONTEND_URL=https://uasspain.example.com
SITE_URL=https://uasspain.example.com
VITE_SITE_URL=https://uasspain.example.com
VITE_API_URL=https://uasspain.example.com/api
VITE_WS_URL=wss://uasspain.example.com/ws
CORS_ALLOWED_ORIGINS=https://uasspain.example.com,https://www.uasspain.example.com
CSRF_TRUSTED_ORIGINS=https://uasspain.example.com,https://www.uasspain.example.com
TRUST_PROXY=True

# --- Security / cookies ---
JWT_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Database / Redis ---
DB_NAME=uasspain
DB_USER=uasspain_migrate
DB_PASSWORD=replace-with-a-strong-random-password
DB_HOST=postgres
DB_PORT=5432
# TLS obligatorio hacia PostgreSQL (cert de la PKI interna en secrets)
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/pg_tls_ca
# Optional legacy aliases kept for compatibility with older scripts.
DB_APP_PASSWORD=replace-with-a-strong-random-password
DB_MIGRATE_PASSWORD=replace-with-a-strong-random-password
# Redis con TLS + ACL (usuario "app")
REDIS_URL=rediss://app:replace-with-a-strong-random-password@redis:6379/0?ssl_cert_reqs=required&ssl_ca_certs=/run/secrets/redis_tls_ca

# --- Ports (nginx edge: único puerto público, ligado a loopback) ---
HTTP_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
