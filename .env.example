# Configuración no secreta del stack Docker canónico.
# Copie este archivo a .env. Los secretos viven en .secrets/ y nunca en Git.

SITE_URL=https://your-domain.example
VITE_SITE_URL=https://your-domain.example
VITE_API_URL=https://your-domain.example/api
VITE_WS_URL=wss://your-domain.example/ws
FRONTEND_URL=https://your-domain.example
# Optional exact OAuth origin; otherwise FRONTEND_URL is used.
GOOGLE_OAUTH_PUBLIC_ORIGIN=
# Leave empty until public HTTPS has passed certificate and hostname validation.
GOOGLE_OAUTH_VERIFIED_PUBLIC_ORIGIN=
CORS_ALLOWED_ORIGINS=https://your-domain.example

DB_NAME=uasspain
DB_USER=uasspain
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/pg_tls_ca

# Opcional: volúmenes de una reconstrucción verificada. Vacío conserva el nombre
# derivado del proyecto Compose; los proyectos aislados no reutilizan los datos.
POSTGRES_DATA_VOLUME_NAME=
POSTGRES_VARLIB_VOLUME_NAME=
# Instalacion cifrada: activar ambos archivos Compose y entregar la clave DPAPI
# con scripts/unlock-postgres-storage.ps1 tras cada arranque de PostgreSQL.
POSTGRES_CIPHERTEXT_VOLUME_NAME=
# Windows: COMPOSE_FILE=docker-compose.yml;docker-compose.encrypted.yml

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Sistema
BOOTSTRAP_ADMIN_DNI=
BOOTSTRAP_ADMIN_BIRTH_DATE=

REGISTRATION_ENABLED=true
JWT_COOKIE_SECURE=true
RUST_LOG=info,tower_http=info

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=UASSPAIN <noreply@your-domain.example>
# One public destination, used by the frontend build and contact backend.
# Empty uses backend-rust/src/contact-defaults.json (the published mailbox).
CONTACT_RECIPIENT_EMAIL=
# Corporate contact delivery is independent from authentication/system email.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURITY=STARTTLS
CONTACT_SMTP_USER=
CONTACT_SMTP_FROM=
CONTACT_SMTP_PASSWORD_FILE=.secrets/contact_smtp_password
# Optional trusted private CA inside the container; never disable TLS checking.
CONTACT_SMTP_CA_FILE=
# Postmark API alternative; the token is read only from a runtime secret file.
POSTMARK_SERVER_TOKEN_FILE=.secrets/postmark_server_token
POSTMARK_SERVER_TOKEN=
# Comma-separated real profile UUIDs for technical accounts that cannot self-deactivate.
ESSENTIAL_ACCOUNT_PROFILE_IDS=

# Read-only authenticated host observations; key provisioned by the technician
# in .secrets/backup-sftp/infrastructure_agent.key, never in Git or images.
INFRASTRUCTURE_AGENT_DIRECTORY=./.run/infrastructure-agent
INFRASTRUCTURE_ENABLED=true
POSTMARK_FROM=

GOOGLE_CLIENT_ID=

VPN_SERVER2_IP=
BACKUP_MIN_FREE_BYTES=268435456
# Rutas dentro del contenedor; montar claves y hosts verificados en
# .secrets/backup-sftp/ (solo lectura). No incluir sus contenidos en .env.
BACKUP_EXTERNAL_1_KEY_FILE=/run/backup-secrets/external_1.key
BACKUP_EXTERNAL_1_KNOWN_HOSTS_FILE=/run/backup-secrets/known_hosts
BACKUP_EXTERNAL_2_KEY_FILE=/run/backup-secrets/external_2.key
BACKUP_EXTERNAL_2_KNOWN_HOSTS_FILE=/run/backup-secrets/known_hosts
BACKUP_EXTERNAL_1_VPN_IP=
BACKUP_EXTERNAL_2_VPN_IP=
# Carpetas adicionales preparadas y montadas para copias locales, separadas
# por ':' dentro de Linux. Vacío limita el destino al almacenamiento de backups.
BACKUP_LOCAL_ALLOWED_ROOTS=
HTTP_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TZ=Europe/Madrid

# Rutas locales de secretos consumidas por Docker Compose.
SECRET_KEY_FILE=.secrets/secret_key
DB_PASSWORD_FILE=.secrets/db_password
DB_APP_PASSWORD_FILE=.secrets/db_app_password
DB_MIGRATION_PASSWORD_FILE=.secrets/db_migration_password
DB_BACKUP_PASSWORD_FILE=.secrets/db_backup_password
DB_RESTORE_PASSWORD_FILE=.secrets/db_restore_password
DB_MONITOR_PASSWORD_FILE=.secrets/db_monitor_password
SMTP_PASSWORD_FILE=.secrets/smtp_password
FIELD_ENCRYPTION_KEY_FILE=.secrets/field_encryption_key
BOOTSTRAP_ADMIN_PASSWORD_FILE=.secrets/bootstrap_admin_password
REDIS_PASSWORD_FILE=.secrets/redis_password
